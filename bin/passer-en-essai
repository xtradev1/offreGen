#!/usr/bin/env php
<?php

declare(strict_types=1);

// Transforme un compte de démonstration en compte d'essai : les deux offres d'exemple et leurs clients inventés
// partent, les produits d'exemple jamais modifiés repartent au prix 0, ce que l'artisan a dicté, créé ou modifié
// reste. Le compte reçoit N offres (10 par défaut) en plus de celles déjà dictées. Refuse un compte qui n'est pas
// de démonstration. Avec --acces, l'artisan reçoit un courriel et choisit son mot de passe (lien valable 7 jours).
// Usage : bin/passer-en-essai <courriel> [--offres=N] [--acces]

use OffreGen\Http\Conteneur;

if (PHP_SAPI !== 'cli') {
    exit(1);
}
require dirname(__DIR__) . '/vendor/autoload.php';

$positionnels = [];
$offres = 10;
$acces = false;
foreach (array_slice($argv, 1) as $arg) {
    if ($arg === '--acces') {
        $acces = true;
    } elseif (preg_match('/^--offres=(\d+)$/', $arg, $m) === 1) {
        $offres = (int) $m[1];
    } else {
        $positionnels[] = $arg;
    }
}
if (count($positionnels) !== 1) {
    fwrite(STDERR, "Usage : bin/passer-en-essai <courriel> [--offres=N] [--acces]\n");
    exit(2);
}
$courriel = $positionnels[0];

try {
    $c = Conteneur::depuisEnvironnement(dirname(__DIR__));
    $bilan = $c->comptes()->passerEnEssai($courriel, $offres);
} catch (\InvalidArgumentException $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(1);
}

echo "$courriel est un compte d'essai : {$bilan['offres']} offre(s) d'exemple et {$bilan['clients']} client(s) d'exemple retirés, "
    . "{$bilan['produits']} produit(s) d'exemple remis au prix 0, $offres offre(s) à dicter.\n";
if (!$acces) {
    exit(0);
}
try {
    $c->liensAcces()->envoyerAcces($courriel);
} catch (\Throwable $e) {
    // Le passage est fait : il suffit de relancer l'envoi par « mot de passe oublié » une fois la messagerie réparée.
    fwrite(STDERR, "Courriel d'accès non envoyé : {$e->getMessage()}\nL'artisan peut demander un lien depuis « Mot de passe oublié ».\n");
    exit(1);
}
echo $c->messagerieReelle()
    ? "Courriel d'accès envoyé (lien valable 7 jours).\n"
    : "Courriel d'accès écrit dans var/courriels, rien n'est parti : MESSAGERIE n'est pas « smtp » dans le .env.\n";
