{# Barre d'onglets du bas. Décisions de Xavier sur la maquette 24 (2026-11-15) : le micro au centre, sur chaque
   écran qui a la barre (D1, remplace la variante B du 2026-11-12) ; Catalogue et Réglages rangés dans « Plus » (D2).
   « actif » : offres, clients, factures, plus, catalogue ou reglages (ces deux derniers allument « Plus »).
   À partir de 1024 px, la même barre devient le menu de gauche (D12, D13) : Catalogue et Réglages y ont leur entrée,
   « Plus » disparaît, le micro devient « Dicter une offre » (touche D) et l'import le suit. Les classes pc-seul et
   mobile-seul font le tri dans app.css. La feuille de dictée vient avec la barre : un seul exemplaire par écran. #}
{% set dans_plus = actif in ['plus', 'catalogue', 'reglages'] %}
<nav class="tabs{% if pc_seul ?? false %} pc-seul{% endif %}" aria-label="Sections">
  <span class="marque-pc pc-seul"><picture><source srcset="/img/dicta-logo-sombre.svg" media="(prefers-color-scheme: dark)"><img src="/img/dicta-logo-clair.svg" alt="{{ nom_application }}" width="177" height="64"></picture></span>
  <a href="/"{% if actif == 'offres' %} aria-current="page"{% endif %}>
    <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h6"/></svg>Offres</a>
  <a href="/clients"{% if actif == 'clients' %} aria-current="page"{% endif %}>
    <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14c2 .7 3 2.7 3 6"/></svg>Clients</a>
  <button class="micro-central" type="button" aria-label="Dicter une offre" aria-keyshortcuts="D" data-enregistrer><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg></span><b class="pc-seul">Dicter une offre</b></button>
  <a href="/factures"{% if actif == 'factures' %} aria-current="page"{% endif %}>
    <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6M9 16h3"/></svg>Factures</a>
  <a class="pc-seul" href="/catalogue"{% if actif == 'catalogue' %} aria-current="page"{% endif %}>
    <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="m3 8 9 5 9-5M12 13v8"/></svg>Catalogue</a>
  <a class="pc-seul" href="/reglages"{% if actif == 'reglages' %} aria-current="page"{% endif %}>
    <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1"/><circle cx="15" cy="6" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="17" cy="18" r="2"/></svg>Réglages</a>
  <a class="mobile-seul" href="/plus"{% if dans_plus %} aria-current="page"{% endif %}>
    <svg class="i" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>Plus</a>
  {% set role_du_compte = role_equipe() %}
  {% if role_du_compte %}<a class="pc-seul" href="/admin">
    <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h13l-3-3M17 17H4l3 3"/></svg>{{ role_du_compte.espace }}</a>{% endif %}
  <a class="pc-seul importer" href="/import" data-importer>
    <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>Importer un fichier</a>
  <small class="pc-seul aide-micro">Micro du portable ou d'un casque · touche <kbd>D</kbd></small>
</nav>
{# sans_dictee : la page Import porte déjà la sienne (un seul exemplaire, des identifiants uniques). #}
{% if not (sans_dictee ?? false) %}{% include '_nouvelle_offre.html.twig' with {rond: true, barre: true} %}{% endif %}
