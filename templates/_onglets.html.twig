{# Barre d'onglets du bas. Décisions de Xavier sur la maquette 24 (2026-11-15) : le micro au centre, sur chaque
   écran qui a la barre (D1, remplace la variante B du 2026-11-12) ; Catalogue et Réglages rangés dans « Plus » (D2).
   « actif » : offres, clients, factures, plus, catalogue ou reglages (ces deux derniers allument « Plus »).
   La feuille de dictée vient avec la barre : un seul exemplaire par écran. #}
{% set dans_plus = actif in ['plus', 'catalogue', 'reglages'] %}
<nav class="tabs" aria-label="Sections">
  <a href="/"{% if actif == 'offres' %} aria-current="page"{% endif %}>
    <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h6"/></svg>Offres</a>
  <a href="/clients"{% if actif == 'clients' %} aria-current="page"{% endif %}>
    <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14c2 .7 3 2.7 3 6"/></svg>Clients</a>
  <button class="micro-central" type="button" aria-label="Dicter une offre" data-enregistrer><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg></span></button>
  <a href="/factures"{% if actif == 'factures' %} aria-current="page"{% endif %}>
    <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6M9 16h3"/></svg>Factures</a>
  <a href="/plus"{% if dans_plus %} aria-current="page"{% endif %}>
    <svg class="i" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>Plus</a>
</nav>
{% include '_nouvelle_offre.html.twig' with {rond: true, barre: true} %}
