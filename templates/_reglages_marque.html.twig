{% import '_reglages_macros.html.twig' as f %}
{# Ma marque, en trois touchers : le logo (envoyé à part, formulaire form-logo, sa couleur est proposée
   d'office), la couleur, le modèle. La CSP refuse les styles en ligne : pastilles dessinées en SVG. #}
<div class="card" id="marque">
  {# Mise en route : le logo a son étape à lui (_reglages_logo.html.twig) ; ici, la couleur puis le modèle. #}
  {% if not assistant %}
  <fieldset class="groupe">
    <legend>1. Logo</legend>
    <div class="logo-ligne">
      {% if marque.logo %}<img class="logo-apercu" src="/reglages/logo?v={{ marque.logo }}" alt="Votre logo">{% else %}<span class="muted petit">Aucun logo</span>{% endif %}
      <label class="btn" for="logo">{{ marque.logo ? 'Changer' : 'Choisir le logo' }}</label>
      <input class="cache" id="logo" name="logo" type="file" accept="image/png,image/jpeg" form="form-logo" data-envoi-auto>
      {% if marque.logo %}<button class="lien" type="submit" form="form-logo-retirer">Retirer</button>{% endif %}
    </div>
    <noscript><button class="btn" type="submit" form="form-logo">Envoyer le logo choisi</button></noscript>
    <p class="muted petit">PNG ou JPEG, 5&nbsp;Mo au plus. Sa couleur devient celle de vos documents.</p>
  </fieldset>
  {% endif %}
  <fieldset class="groupe choix">
    <legend>{{ assistant ? texte('e.couleur') : '2. Couleur' }}</legend>
    <div class="teintes">
      {% for t in teintes %}
        <label class="teinte" title="{{ t == marque.couleurDuLogo ? 'Couleur du logo' : t }}"><input type="radio" name="couleur_choix" value="{{ t }}"{% if champs.couleur_choix == t %} checked{% endif %}>
          <svg viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="5" fill="{{ t }}"/></svg><span class="cache">{{ t == marque.couleurDuLogo ? 'Couleur du logo' : 'Couleur ' ~ t }}</span></label>
      {% endfor %}
      <label class="puce teinte-autre"><input type="radio" name="couleur_choix" value="autre"{% if champs.couleur_choix == 'autre' %} checked{% endif %}>Autre</label>
    </div>
    <div class="champ si-autre">
      <label for="couleur">Votre couleur</label>
      <input id="couleur" name="couleur" type="color" value="{{ champs.couleur|default('#1D4E89')|lower }}"{{ f.invalide(erreurs, 'couleur') }}>
    </div>
    {{ f.erreur(erreurs, 'couleur') }}
    {# 2b (maquette du 5e tour du chantier responsive, validée par Xavier le 2026-11-20) : une couleur tapée, ou celle du
       logo, sous 7:1 sur le papier blanc. Deux versions plus foncées de la même teinte, d'un toucher ; sans JavaScript,
       le bouton envoie le formulaire. app.js (avisCouleur) le tient à jour pendant le choix. #}
    <div class="avis-couleur" data-avis-couleur data-teintes="{{ proposees|join(',') }}" aria-live="polite"{% if not avis %} hidden{% endif %}>
      <p><b data-avis-titre>{{ avis and avis.contraste >= 4.5 ? 'Cette couleur manque de contraste sur le papier blanc' : 'Cette couleur se lit mal sur le papier blanc' }}</b> (contraste <span data-avis-contraste>{{ avis.rapport ?? '' }}</span>:1).<span data-avis-pale{% if avis and avis.contraste >= 4.5 %} hidden{% endif %}> Vos documents l'emploient foncée juste assez pour rester lisible.</span></p>
      <p>Prenez une version plus foncée de la même teinte&nbsp;:</p>
      {% for niveau, nom in {bien: 'Bien visible', visible: 'Visible'} %}
        <button class="choix-couleur" type="submit" name="couleur_prise" value="{{ avis[niveau] ?? '' }}" data-niveau="{{ niveau }}">
          <svg viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="5" fill="{{ avis[niveau] ?? '#FFFFFF' }}"/></svg>
          <span><b>{{ nom }}</b><small><span data-hex>{{ avis[niveau] ?? '' }}</span> · contraste <span data-rapport>{{ avis[niveau ~ '_rapport'] ?? '' }}</span>:1</small></span></button>
      {% endfor %}
    </div>
  </fieldset>
  <fieldset class="groupe">
    <legend>{{ assistant ? texte('e.modele') : '3. Modèle' }}</legend>
    {# Douze modèles en quatre familles (Xavier, 2026-11-19) ; celui du métier du compte est marqué. #}
    {% for famille in familles %}
    <h3 class="famille">{{ famille.nom }}</h3>
    <div class="modeles">
      {% for cle in famille.modeles %}
        {% set nom = modeles[cle] %}
        <div class="modele-case">
          <label class="modele"><input type="radio" name="modele" value="{{ cle }}"{% if champs.modele == cle %} checked{% endif %}>
            {% if vignettes[cle] is defined %}<span class="vignette" data-vignette="{{ cle }}">{{ vignettes[cle]|raw }}</span>{% else %}<img src="/img/modeles/{{ cle }}.jpg" alt="" width="180" height="255">{% endif %}<span>{{ nom }}</span>{% if cle == propose %}<span class="badge propose">Proposé pour votre métier</span>{% endif %}</label>
          <a class="voir" href="/reglages/modeles/{{ cle }}{% if assistant %}?depuis=bienvenue{% endif %}" data-grand="/img/modeles/grand/{{ cle }}.jpg" data-cle="{{ cle }}" data-nom="{{ nom }}" aria-label="Voir le modèle {{ nom }} en grand">
            <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>Voir en grand</a>
        </div>
      {% endfor %}
    </div>
    {% endfor %}
  </fieldset>
  {# Les phrases du document, pour les douze modèles (maquette MAQUETTE-lettre-phrases.html, réponses de Xavier du
     2026-11-20 ; MAQUETTE-lettre-phrases-auto.html, réponses du 2026-11-23, M4 B). La formule d'appel, le début et la
     fin vont dans Lettre, et dans les autres modèles si l'artisan le choisit. Un toucher sur une tournure la met dans
     le champ (app.js, tournuresLettre). Les phrases tirées de l'offre sont repliées (M3 A), une pastille se pose d'un
     toucher (app.js, pastillesPhrases). L'enregistrement automatique suit ; un champ vidé reprend la phrase de
     l'application (M2 A). #}
  <fieldset class="groupe phrases-doc">
    <legend>4. Les phrases du document</legend>
    <h3 class="famille">Formule d'appel, début et fin</h3>
    <div class="lettre-appel" role="radiogroup" aria-labelledby="lettre-partout-titre">
      <span class="lettre-titre" id="lettre-partout-titre">Où les écrire</span>
      <label class="radio"><input type="radio" name="lettre_partout" value="0"{% if champs.lettre_partout != '1' %} checked{% endif %}> Dans le modèle Lettre seulement</label>
      <label class="radio"><input type="radio" name="lettre_partout" value="1"{% if champs.lettre_partout == '1' %} checked{% endif %}> Dans les douze modèles&nbsp;: au début du document, et avant les signatures</label>
    </div>
    <p class="muted petit">Après le début, le document ajoute la date de la visite (offre). Lettre ajoute aussi l'adresse du chantier, ou le numéro de l'offre (facture)&nbsp;; les autres modèles les écrivent dans leurs cases.</p>
    <div class="lettre-appel" role="radiogroup" aria-labelledby="lettre-appel-titre">
      <span class="lettre-titre" id="lettre-appel-titre">Formule d'appel</span>
      <label class="radio"><input type="radio" name="lettre_appel" value="fixe"{% if champs.lettre_appel != 'client' %} checked{% endif %}> La même pour tous&nbsp;: «&nbsp;Madame, Monsieur,&nbsp;»</label>
      <label class="radio"><input type="radio" name="lettre_appel" value="client"{% if champs.lettre_appel == 'client' %} checked{% endif %}> Selon le client&nbsp;: «&nbsp;Madame,&nbsp;», «&nbsp;Monsieur,&nbsp;», ou «&nbsp;Madame, Monsieur,&nbsp;» pour une famille ou une entreprise. La fin de la lettre suit.</label>
    </div>
    {% for doc, titre in {offre: "Dans une offre", facture: "Dans une facture"} %}
      <h4 class="phrases-titre">{{ titre }}</h4>
      {% for partie, nom in {debut: 'Début', fin: 'Fin'} %}
        {% set champ = 'lettre_' ~ doc ~ '_' ~ partie %}
        <div class="champ">
          <label for="{{ champ }}">{{ nom }}</label>
          <div class="puces tournures" role="group" aria-label="Tournures proposées, {{ nom|lower }} {{ doc == 'offre' ? "de l'offre" : 'de la facture' }}">
            {% for t in tournures[doc ~ '_' ~ partie] %}<button type="button" class="puce" data-tournure="{{ t }}" data-pour="{{ champ }}" title="{{ t }}">{{ loop.first ? 'Actuelle' : 'Tournure ' ~ loop.index }}</button>{% endfor %}
          </div>
          <textarea id="{{ champ }}" name="{{ champ }}" rows="4" maxlength="500"{{ f.invalide(erreurs, champ) }}>{{ champs[champ] ?? '' }}</textarea>
          {{ f.erreur(erreurs, champ) }}
        </div>
      {% endfor %}
    {% endfor %}
    <h3 class="famille">Phrases tirées de l'offre</h3>
    <p class="muted petit">Écrivez-les à votre façon. Les pastilles entre crochets, comme [date], écrivent la donnée de l'offre&nbsp;; touchez une pastille pour la poser. Une phrase vidée reprend celle de l'application.</p>
    {% for doc, titre in {offre: 'Dans une offre', facture: 'Dans une facture'} %}
      <h4 class="phrases-titre">{{ titre }}</h4>
      {% for p in phrases[doc] %}
        {% set champ = 'phrase_' ~ p.cle %}
        <details class="phrase-doc"{% if erreurs[champ] is defined %} open{% endif %}>
          <summary><span class="phrase-nom">{{ p.nom }}</span> <span class="phrase-etat" data-etat-phrase>{{ champs[champ] != p.origine ? 'Réécrite' : "Celle de l'application" }}</span></summary>
          <div class="champ">
            <label for="{{ champ }}">{{ p.quand }}</label>
            <textarea id="{{ champ }}" name="{{ champ }}" rows="3" maxlength="500" data-origine="{{ p.origine }}"{{ f.invalide(erreurs, champ) }}>{{ champs[champ] }}</textarea>
            <div class="puces jetons" role="group" aria-label="Pastilles, {{ p.nom|lower }}">
              {% for x in p.pastilles %}<button type="button" class="puce jeton" data-pastille="[{{ x }}]" data-pour="{{ champ }}">[{{ x }}]</button>{% endfor %}
              <button type="button" class="puce" data-remettre="{{ champ }}">Reprendre celle de l'application</button>
            </div>
            {{ f.erreur(erreurs, champ) }}
          </div>
        </details>
      {% endfor %}
      {% if doc == 'facture' %}<p class="muted petit">La phrase d'une facture annulée reste fixe&nbsp;: elle dit au client de ne pas la payer.</p>{% endif %}
    {% endfor %}
  </fieldset>
</div>
