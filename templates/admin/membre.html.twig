{% extends 'admin/base.html.twig' %}

{# Fiche d'un membre : changer son rôle, ou le retirer de l'équipe. Retiré, il garde son espace artisan et ses
   artisans passent à l'administrateur qui agit (Xavier, 2026-11-19). Une nouvelle invitation lui rend un rôle. #}
{% set libelles = {moderateur: 'Modérateur', commercial: 'Commercial'} %}
{% block retour %}<a class="back" href="/admin/equipe">Équipe</a>{% endblock %}
{% block sous %}<p>{{ libelles[membre.role] }} · {{ membre.courriel }}</p>{% endblock %}

{% block contenu %}
  <p class="muted">{{ membre.artisans }} artisan{{ membre.artisans > 1 ? 's' : '' }} créé{{ membre.artisans > 1 ? 's' : '' }}{% if membre.offres_max is not null %} · {{ membre.offres_max }} offres dans son espace artisan{% endif %}</p>
  <form class="actions-admin" method="post" action="/admin/equipe/{{ membre.id }}/role">
    <input type="hidden" name="_csrf" value="{{ csrf() }}">
    {% if membre.role == 'commercial' %}
      <button class="btn large" type="submit" name="role" value="moderateur">Passer modérateur</button>
    {% else %}
      <button class="btn large" type="submit" name="role" value="commercial">Passer commercial</button>
    {% endif %}
    <button class="btn large danger" type="submit" name="role" value="">Retirer de l'équipe</button>
  </form>
  <p class="muted">Retirée de l'équipe, cette personne garde son espace artisan. Ses artisans passent à vous.</p>
{% endblock %}
