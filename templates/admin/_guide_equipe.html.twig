{# Le guide à anneau du commercial, côté administration (chantier onboarding, lot 8 ; O11 de Xavier : « quand on dit faire
   ma démo, tu cliques, et là je veux qu'il y ait un suivi […] cliquez ici »). Onze gestes en tout : cinq ici (l'onglet
   « Clients », créer la démo, le métier, « Créer la démo », l'ouvrir sur cet appareil ; E3 de Xavier, 2026-11-23 : « on va
   sous artisans (renommé client) et on a créer une démo »), six dans la démo d'entraînement (_guide_artisan.html.twig,
   en mode équipe), jusqu'à « Revenir à mon espace ». « page » : suivi, clients, nouvelle ou prete. #}
<link rel="stylesheet" href="{{ fichier('/css/guide.css') }}">
<script src="{{ fichier('/js/guide.js') }}" defer></script>
<div class="guide" hidden data-guide="equipe" data-total="11" data-fin="/admin/guide/fini" data-csrf="{{ csrf() }}">
  {% if page == 'suivi' %}
    <template data-n="1" data-cible=".tabs a[href='/admin/artisans']">{{ texte('g.clients') }}</template>
  {% elseif page == 'clients' %}
    <template data-n="2" data-cible=".actionbar a[href='/admin/demos/nouvelle'], .admin-tete a[href='/admin/demos/nouvelle']">{{ texte('g.rond') }}</template>
  {% elseif page == 'nouvelle' %}
    <template data-n="3" data-cible="label:has(input[name='metier'][value='peintre'])">{{ texte('g.metier') }}</template>
    <template data-n="4" data-cible=".actionbar button[form='demo'], #demo button[type='submit']">{{ texte('g.creer') }}</template>
  {% else %}
    <template data-n="5" data-cible="[data-ouvrir-entrainement]" data-bulle="haut">{{ texte('g.qr') }}</template>
  {% endif %}
</div>
