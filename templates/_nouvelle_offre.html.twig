{# Nouvelle offre : parler ou importer, en un geste.
   Accueil (rond = true) : deux boutons ronds au centre, au pouce, sans texte : le micro à gauche,
   l'import à droite. L'enregistrement et l'envoi montent ensuite dans une fenêtre du bas.
   Sans JavaScript, l'import mène à /import ; le micro, qui a besoin de JavaScript, reste caché.
   Page /import : les deux boutons dans la page, qui marche aussi sans JavaScript. #}
{% set icone_micro %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>{% endset %}
{% set icone_import %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>{% endset %}
{% set sans_micro %}Le micro demande une connexion sécurisée (https). En attendant, enregistrez avec le téléphone, puis importez le fichier.{% endset %}
{% set rond = rond|default(false) %}
{% set etats %}
  {# Enregistrement en plein écran sombre (piste B de la maquette du parcours de la dictée, Xavier, 2026-11-26) : l'état,
     le minuteur, l'onde de la voix, un conseil qui tourne, « Terminer » au centre, Abandonner à gauche, Pause à droite.
     Cinq secondes sans voix : la carte du conseil devient l'alerte. La fenêtre monte dès le toucher (2026-11-25) : tant
     que le micro s'ouvre, ni conseil, ni « Terminer », ni Pause ne se montrent. app.js pose les classes ouverture,
     pause et urgent, remplit l'onde et fait tourner les conseils (data-conseils, ceux de l'activité du compte). #}
  {% set m_dictee = mots() %}
  {% set conseils = [m_dictee.conseil_1, m_dictee.conseil_2, m_dictee.conseil_3] %}
  <div class="rec" data-etat="enregistrement" hidden>
    <p class="rec-haut"><span class="rec-etat" role="status" data-etat-micro data-ouverture="Le micro s'ouvre…" data-en-cours="Enregistrement" data-en-pause="En pause">Enregistrement</span><span>Nouvelle offre</span></p>
    <div class="timer" data-minuteur>00:00</div>
    <div class="onde" data-onde aria-hidden="true">{% for i in 1..34 %}<i></i>{% endfor %}</div>
    {# L'alerte (silence, arrêt, limite) se dit ici pour un lecteur d'écran ; les conseils qui tournent ne sont pas lus. #}
    <p class="rec-annonce" role="status" data-annonce></p>
    <div class="rec-conseil" data-conseil>
      <small data-conseil-titre data-silence="Le micro n'entend rien">Conseil 1 sur {{ conseils|length }}</small>
      <p data-consigne data-conseils="{{ conseils|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}" data-silence="Parlez plus près, ou vérifiez qu'un casque Bluetooth ne l'a pas pris.">{{ conseils[0] }}</p>
    </div>
    {# iPhone et iPad, Safari : une fois par appareil, quand Safari vient de demander le micro (Xavier, 2026-11-24).
       Un site ne peut pas rendre l'autorisation permanente ; Safari le peut, réglé par l'artisan.
       Texte : Safari 26, chemin trouvé par Xavier le 2026-11-25. data-ancien : Safari 18 et avant (bouton « aA », guides tiers).
       data-ecran : l'icône de l'écran d'accueil, sans barre d'adresse. #}
    <p class="muted petit centre" data-astuce-micro hidden
       data-ancien="Pour ne plus autoriser le micro à chaque fois&nbsp;: touchez «&nbsp;aA&nbsp;» à côté de l'adresse, puis Réglages du site web, Micro, Autoriser."
       data-ecran="Pour ne plus autoriser le micro à chaque fois&nbsp;: dans les Réglages, ouvrez Safari, puis Micro, Autoriser.">Pour ne plus autoriser le micro à chaque fois&nbsp;: dans la barre d'adresse, touchez le bouton de la page (un rectangle et deux traits), puis les trois petits points, et tout en bas, Micro, Autoriser.</p>
    <div class="rec-commandes">
      <button class="rec-petit" type="button" data-abandonner data-abandonner-texte="Abandonner" data-annuler="Annuler"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></span><b>Abandonner</b></button>
      <button class="rec-stop" type="button" data-terminer aria-label="Terminer et créer l'offre"><span><i></i></span><b>Terminer</b></button>
      <button class="rec-petit" type="button" data-pause data-pause-texte="Pause" data-reprendre="Reprendre" hidden><span><svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg><svg class="i-reprendre" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span><b>Pause</b></button>
    </div>
  </div>

  {# Dès « Terminer » ou le fichier choisi : l'attente, en plein écran sombre (maquette v2 du parcours de la dictée,
     Xavier, 2026-11-26). L'anneau se remplit : l'envoi réel d'abord, puis le temps écoulé sur le temps attendu (app.js).
     Trois étapes nommées ; ni texte entendu ni lignes qui se dessinent. La phrase du bas ne vient qu'une fois l'envoi fait. #}
  {% set etapes_depart = [] %}
  {% for libelle in constant('OffreGen\\Http\\Controleur\\EnregistrementControleur::ETAPES') %}
    {% set etapes_depart = etapes_depart|merge([{libelle: libelle, etat: loop.first ? 'cur' : 'todo'}]) %}
  {% endfor %}
  <div class="attente" data-etat="envoi" hidden>
    <h2 class="attente-titre">Préparation de l'offre</h2>
    <div class="anneau" data-anneau role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Préparation de l'offre">
      <span><b data-anneau-part>0&nbsp;%</b><small data-anneau-reste></small></span>
    </div>
    {% include '_etapes.html.twig' with {etapes: etapes_depart} %}
    <p class="attente-quitter" data-attente-quitter hidden data-echec="Fermez cette fenêtre&nbsp;: la dictée est dans «&nbsp;Offres&nbsp;», où vous pouvez la relancer.">Vous pouvez quitter l'application&nbsp;: l'offre vous attendra dans «&nbsp;Offres&nbsp;».</p>
  </div>

  {# L'offre est prête et des lignes restent à relire (maquette v2, Xavier, 2026-11-26) : combien, sans le prix ; un
     toucher mène à la relecture. Propre, l'offre ne passe pas par ici : son PDF s'ouvre, ou le choix de son client
     (Offre\Arrivee). app.js remplit les nombres et les adresses d'après l'état de l'enregistrement. #}
  <div class="prete" data-etat="prete" hidden>
    <span class="prete-coche" aria-hidden="true"></span>
    <h2 tabindex="-1" data-prete-titre>Offre prête</h2>
    <p class="prete-qui"><b data-prete-client></b><span data-prete-objet></span></p>
    <p class="prete-tuiles"><span><b data-prete-lignes></b><span data-prete-lignes-mot>lignes</span></span><span class="warn"><b data-prete-relire></b>à relire</span></p>
    <a class="btn primary large" href="/" data-prete-suite>Relire</a>
    <a class="lien" href="/" data-prete-offre>Voir l'offre entière</a>
  </div>

  <div data-etat="court" hidden>
    <p class="alerte warn" role="alert">Enregistrement non pris en compte&nbsp;: 5 secondes au minimum.</p>
    <button class="btn primary large" type="button" data-recommencer>Recommencer</button>
  </div>

  {# Fichier importé de plus de 30 minutes, vu par le navigateur avant l'envoi (Xavier, 2026-11-24). Rien n'est parti. #}
  <div data-etat="long" hidden>
    <p class="alerte warn" role="alert">Fichier trop long&nbsp;: {{ (duree_max_secondes / 60)|round(0, 'ceil') }}&nbsp;minutes au maximum. Il n'a pas été envoyé.</p>
    <button class="btn primary large" type="button" data-autre-fichier>Choisir un autre fichier</button>
  </div>

  <div data-etat="echec" hidden>
    <p class="alerte bad" role="alert" data-echec-texte>L'envoi a échoué.</p>
    <button class="btn primary large" type="button" data-reessayer>Réessayer l'envoi</button>
    <p class="centre"><a class="lien" href="#" download="visite.webm" data-garder hidden>Garder l'enregistrement dans un fichier</a></p>
  </div>

  {# Sous-chantier 27, R1 B (Xavier, 2026-11-18) : une dictée restée sur le téléphone, proposée à la réouverture.
     app.js écrit le texte (date, durée) et n'ouvre cette fenêtre que s'il en trouve une. #}
  <div class="suivi" data-etat="reprise" hidden>
    <h2 class="suivi-titre">Une dictée n'est pas partie</h2>
    <p data-reprise-texte></p>
    {# Recette AB-1 (Xavier, 2026-11-24) : une dictée coupée se continue à la suite. app.js cache ce bouton quand la
       dictée ne peut plus grandir (30 minutes atteintes, 5 parties, micro absent, essai épuisé) et rend alors
       « Envoyer » principal. #}
    <button class="btn primary large" type="button" data-reprise-continuer hidden>Continuer la dictée</button>
    <button class="btn primary large" type="button" data-reprise-envoyer>Envoyer et créer l'offre</button>
    <p class="centre"><a class="lien" href="#" data-reprise-garder>Garder dans un fichier</a></p>
    <p class="centre"><button class="lien" type="button" data-reprise-supprimer>Supprimer la dictée</button></p>
  </div>
{% endset %}

{% set essai_compte = essai() %}
{# Une démo finie refuse la dictée comme un essai épuisé (chantier onboarding, lot 2). #}
{% set demo_finie = demo() %}
{% set refus = essai_compte and essai_compte.epuise ? essai_compte.refus : (demo_finie and demo_finie.terminee ? constant('OffreGen\\Http\\Controleur\\ImportControleur::DEMO_TERMINEE') : '') %}
<div class="nouvelle" data-nouvelle data-duree-max="{{ duree_max_secondes }}"{% if refus %} data-epuise="{{ refus }}"{% endif %}>
  <form id="import" method="post" action="/import" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="{{ csrf() }}">
    <input class="cache" id="audio" name="audio" type="file" accept="audio/*,.m4a,.mp3,.ogg,.opus,.wav,.amr,.3gp,.webm" required data-envoi-fichier>
    {% if not rond %}<noscript><p class="muted">Choisissez le fichier avec «&nbsp;Importer&nbsp;», puis envoyez-le.</p><button class="btn" type="submit">Envoyer le fichier choisi</button></noscript>{% endif %}
  </form>

  {% if rond %}
    {# Le micro est au centre de la barre d'onglets (_onglets.html.twig, décision D1 du 2026-11-15) ; ici, la feuille
       qui monte : enregistrement, envoi, suivi, et l'import quand le micro manque ou est refusé. #}
    <div class="feuille-fond" data-feuille hidden>
      <div class="feuille" role="dialog" aria-modal="true" aria-label="Nouvelle offre">
        <div class="poignee" aria-hidden="true"></div>
        <button class="x coin" type="button" data-fermer aria-label="Fermer" hidden><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
        <div data-etat="refus" hidden>
          <p class="alerte warn" role="alert" data-sans-micro>{{ sans_micro }}</p>
          <a class="btn primary large" href="/import" data-importer>{{ icone_import }}Importer un fichier</a>
        </div>
        {{ etats }}
      </div>
    </div>
  {% else %}
    <div data-etat="choix">
      <div class="choix2">
        <button class="rond micro" type="button" data-enregistrer hidden>{{ icone_micro }}<span>Parler</span></button>
        <label class="rond" for="audio">{{ icone_import }}<span>Importer</span></label>
      </div>
      <p class="alerte info" data-sans-micro hidden>{{ sans_micro }}</p>
    </div>
    {{ etats }}
  {% endif %}
</div>
