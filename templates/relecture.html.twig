{% extends 'base.html.twig' %}

{# Relecture au pouce, une ligne à la fois (décision D5, maquette 24, 2026-11-15). Le contenu descend vers les boutons ;
   le rappel de la dictée est permis ici (CODING_RULES, Ergonomie). #}
{% block titre %}Relecture · {{ offre.titre }} · offreGen{% endblock %}
{% block retour %}<a class="back" href="/offres/{{ offre.id }}">Offre</a>{% endblock %}
{% block entete %}Relecture{% endblock %}
{% block ecran_classe %} relecture{% endblock %}

{% block contenu %}
  {% if l is null %}
    <div class="relu-fin">
      <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
      <h2>Toutes les lignes sont relues</h2>
      <p class="muted">L'offre est prête à être générée.</p>
    </div>
  {% else %}
    <p class="relu-reste">Encore {{ restantes }} à relire</p>
    <div class="relu-carte">
      {% if l.categorie %}<p class="relu-cat">{{ l.categorie }}</p>{% endif %}
      <h2 class="relu-nom">{{ l.designation }}</h2>
      {% if l.entendu %}<p class="relu-entendu">Entendu&nbsp;: «&nbsp;{{ l.entendu }}&nbsp;»</p>{% endif %}
      <form id="relecture" method="post" action="/offres/{{ offre.id }}/relire/{{ l.id }}">
        <input type="hidden" name="_csrf" value="{{ csrf() }}">
        <div class="relu-champs">
          <label class="relu-champ{% if erreurs.quantite is defined %} faux{% endif %}"><span>Quantité <small>{{ l.unite }}</small></span>
            <input name="quantite" value="{{ champs.quantite }}" inputmode="decimal" autocomplete="off" required data-relu-quantite></label>
          <label class="relu-champ{% if erreurs.prix is defined %} faux{% endif %}"><span>Prix <small>CHF</small></span>
            <input name="prix" value="{{ champs.prix }}" inputmode="decimal" autocomplete="off" placeholder="Prix&nbsp;?" data-relu-prix></label>
        </div>
        {% for e in erreurs %}<p class="err" role="alert">{{ e }}</p>{% endfor %}
        <p class="relu-montant"><span>Montant</span><b data-relu-montant>{% if l.prix_centimes > 0 %}{{ (l.quantite_milliemes * l.prix_centimes / 1000)|round|chf }}{% else %}?{% endif %}</b></p>
      </form>
    </div>
  {% endif %}
{% endblock %}

{% block actions %}
  <div class="actionbar">
    {% if l is null %}
      <a class="btn grand" href="/offres/{{ offre.id }}">Revenir à l'offre</a>
      <a class="btn primary grand" href="/offres/{{ offre.id }}/apercu">Générer l'offre</a>
    {% else %}
      <a class="btn grand" href="/offres/{{ offre.id }}/lignes/{{ l.id }}">
        <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16zM13.5 6.5l4 4"/></svg>Corriger</a>
      <button class="btn ok grand" type="submit" form="relecture">
        <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>C'est juste</button>
    {% endif %}
  </div>
{% endblock %}
