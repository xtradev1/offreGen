{% extends 'base.html.twig' %}
{% set sans_menu = true %}

{% block titre %}{{ titre }} · {{ nom_application }}{% endblock %}
{% block entete %}{{ titre }}{% endblock %}

{% block contenu %}
  <p class="erreur-code">{{ code }}</p>
  <p class="muted">{{ titre|trim('.', 'right') }}.</p>
{% endblock %}

{% block actions %}
  <div class="actionbar"><a class="btn" href="/">Retour à l'accueil</a></div>
{% endblock %}
