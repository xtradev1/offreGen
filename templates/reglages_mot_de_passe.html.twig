{% extends 'base.html.twig' %}

{# Rubrique « Mot de passe » des réglages (P4, Xavier, 2026-11-18 : parcours accepté, aspect à refaire avec la marque). #}
{% block titre %}Mot de passe · {{ nom_application }}{% endblock %}
{% block retour %}<a class="back" href="/reglages">Réglages</a>{% endblock %}
{% block entete %}Mot de passe{% endblock %}
{% set onglet = 'reglages' %}

{% block contenu %}
  {% if erreur %}<p class="alerte bad" role="alert">{{ erreur }}</p>{% endif %}
  <form id="changer" method="post" action="/reglages/mot-de-passe">
    <input type="hidden" name="_csrf" value="{{ csrf() }}">
    {% include '_mot_de_passe_compte.html.twig' %}
    <div class="champ">
      <label for="ancien">Mot de passe actuel</label>
      <input id="ancien" name="ancien" type="password" autocomplete="current-password" maxlength="128" required data-oeil-cible>
    </div>
    {% include '_mot_de_passe_champs.html.twig' %}
  </form>
  <p class="muted">Les autres appareils connectés à ce compte seront déconnectés.</p>
{% endblock %}

{% block actions %}
  <div class="actionbar"><button class="btn primary" type="submit" form="changer">Changer le mot de passe</button></div>
{% endblock %}
