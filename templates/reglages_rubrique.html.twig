{% extends 'base.html.twig' %}

{# Une rubrique des réglages, seule à l'écran ; ou une étape de l'assistant du premier lancement
   (assistant défini). Dans les réglages, chaque changement s'enregistre seul (app.js, data-auto) ;
   sans JavaScript, le bouton Enregistrer envoie le formulaire. #}
{# Ma marque : le document et sa couleur, pour les vignettes vivantes (2a). #}
{% block entete_html %}{% if assistant %}<link rel="stylesheet" href="{{ fichier('/css/mise-en-route.css') }}">{% endif %}{% if 'marque' in sections %}<link rel="stylesheet" href="{{ fichier('/css/document.css') }}"><link rel="stylesheet" href="{{ fichier('/css/document-ecran.css') }}"><link rel="stylesheet" href="/reglages/marque.css?v={{ marque.version }}" data-marque-css>{% endif %}{% endblock %}
{% block titre %}{{ titre }} · {{ nom_application }}{% endblock %}
{% block retour %}{% if not assistant %}<a class="back" href="/reglages">Réglages</a>{% endif %}{% endblock %}
{% block entete %}{{ assistant ? 'Bienvenue' : titre }}{% endblock %}
{% block ecran_classe %} gris{% endblock %}

{% block contenu %}
  {% if assistant %}
    {# « Passer le guide » en haut (O15) : la mise en route se fait plus tard, depuis Réglages. #}
    <form method="post" action="/bienvenue/passer" class="passer-guide"><input type="hidden" name="_csrf" value="{{ csrf() }}"><button class="lien" type="submit">{{ texte('e.passer') }}</button></form>
    <div class="progression" aria-hidden="true">{% for i in 1..assistant.total %}<i{% if i <= assistant.numero %} class="fait"{% endif %}></i>{% endfor %}</div>
    <p class="muted petit">Étape {{ assistant.numero }} sur {{ assistant.total }}</p>
    <h2 class="etape-titre">{{ titre }}</h2>
    <p class="etape-sous">{{ texte({entreprise: 'e.ent.sous', tva: 'e.tva.sous', logo: 'e.logo.sous', marque: 'e.mc.sous'}[sections|first]) }}</p>
  {% endif %}
  {% if erreurs is not empty %}<p class="alerte bad" role="alert">Pas enregistré&nbsp;: corrigez les champs signalés.</p>{% endif %}
  <form id="reglages"{% if assistant %} class="etape-{{ sections|first }}"{% endif %} method="post" action="{{ assistant ? '/bienvenue/' ~ sections|first : '/reglages' }}"{% if not assistant %} data-auto{% endif %}>
    <input type="hidden" name="_csrf" value="{{ csrf() }}">
    <input type="hidden" name="retour" value="{{ retour }}">
    {% if not assistant %}<p class="auto-etat" data-auto-etat aria-live="polite"></p>{% endif %}
    {% for s in sections %}{% include '_reglages_' ~ s ~ '.html.twig' %}{% endfor %}
  </form>
  {% if 'marque' in sections or 'logo' in sections %}
    {# Formulaires du logo, hors du formulaire principal : leurs champs s'y rattachent par l'attribut form. #}
    <form id="form-logo" method="post" action="/reglages/logo" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="{{ csrf() }}"><input type="hidden" name="retour" value="{{ assistant ? '/bienvenue/' ~ sections|first : '/reglages/marque' }}"></form>
    <form id="form-logo-retirer" method="post" action="/reglages/logo/retirer"><input type="hidden" name="_csrf" value="{{ csrf() }}"><input type="hidden" name="retour" value="{{ assistant ? '/bienvenue/' ~ sections|first : '/reglages/marque' }}"></form>
  {% endif %}
{% endblock %}

{% block actions %}
  <div class="actionbar">
    {% if assistant %}
      <button class="btn primary" type="submit" form="reglages">{{ assistant.numero == assistant.total ? 'Terminer' : 'Suivant' }}</button>
    {% else %}
      <button class="btn primary" type="submit" form="reglages" data-sans-auto>Enregistrer</button>
    {% endif %}
  </div>
{% endblock %}

{% block onglets %}{% if not assistant %}{% include '_onglets.html.twig' with {actif: 'reglages'} %}{% endif %}{% endblock %}
