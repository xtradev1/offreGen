{% extends 'document/_base.html.twig' %}
{% import 'document/_blocs.html.twig' as b %}
{# Sobre : un filet de couleur sous l'en-tête, les titres de colonnes dans la couleur, le total en anthracite
   (Xavier, 2026-11-19 : « total en noir/anthracite car sinon le contraste peut être mauvais »). #}

{% block fixes %}{{ b.pied(_context) }}{% endblock %}

{% block corps %}
  <div class="doc-in">
    {{ b.tete(_context) }}
    <div class="doc-filet c-fond"></div>
    {{ b.adresse(_context) }}
    <div class="doc-titre c-texte">{{ doc_nom }} n°&nbsp;{{ doc_numero }}</div>
    <div class="doc-objet">{{ doc_objet }}</div>
    {{ b.annulee(_context) }}
    {{ b.infos(_context) }}
    {{ b.lignes(_context, {th: 'c-texte c-filet'}) }}
    {{ b.totaux(_context, {tt: 'c-filet'}) }}
    <div class="doc-fin">
      {{ b.conditions(_context) }}
      {{ b.signatures(_context) }}
    </div>
  </div>
{% endblock %}
