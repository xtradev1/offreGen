{% extends 'document/_base.html.twig' %}
{% import 'document/_blocs.html.twig' as b %}
{# Épuré : de larges marges, un trait de couleur, peu de filets ; chaque poste garde son titre et son total. #}

{% block fixes %}{{ b.pied(_context) }}{% endblock %}

{% block corps %}
  <div class="doc-in">
    {{ b.tete(_context) }}
    {{ b.adresse(_context) }}
    <div class="doc-trait c-fond"></div>
    <div class="doc-titre">{{ doc_nom }} n°&nbsp;{{ doc_numero }}</div>
    <div class="doc-objet">{{ doc_objet }}</div>
    <div class="doc-meta">{{ b.meta(_context, {contact: true}) }}</div>
    {{ b.annulee(_context) }}
    {{ b.texte(_context, 'avant') }}
    {{ b.lignes(_context, {grp_tot: true}) }}
    {{ b.totaux(_context) }}
    {{ b.options(_context) }}
    {{ b.texte(_context, 'apres') }}
    <div class="doc-fin">
      {{ b.conditions(_context) }}
      {{ b.signatures(_context) }}
    </div>
  </div>
{% endblock %}
