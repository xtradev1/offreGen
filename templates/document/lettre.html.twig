{% extends 'document/_base.html.twig' %}
{% import 'document/_blocs.html.twig' as b %}
{# Lettre : l'offre écrite comme un courrier, en empattements, pour une enveloppe à fenêtre à gauche. Les conditions
   se disent en phrases après le tableau. Formule d'appel, début et fin : réglés dans « Phrases du document » (PhrasesLettre). #}

{% block fixes %}{{ b.pied(_context) }}{% endblock %}

{% block corps %}
  <div class="doc-in">
    {{ b.tete(_context) }}
    <table class="doc-env"><tr>
      <td><div class="doc-exp">{{ r.entreprise }}{% for l in coord %} · {{ l }}{% endfor %}</div>{{ b.adresse(_context) }}</td>
      <td class="doc-lieu">{% if r.localite %}{{ r.localite }}, le {% else %}Le {% endif %}{{ (facture ? f.date_facture : (offre.modifiee_le ?? offre.cree_le))|date_longue }}</td>
    </tr></table>
    <div class="doc-concerne"><span class="c-texte">{{ doc_nom }} n°&nbsp;{{ doc_numero }}</span>&nbsp;: {{ doc_objet }}</div>
    {{ b.annulee(_context) }}
    {# Phrases réglées par l'artisan (Compte\PhrasesLettre, réponses de Xavier du 2026-11-20) ; après elles, celles que
       l'application tire de l'offre (L2), réécrites ou non (2026-11-23) : la visite et le chantier, ou l'offre d'où vient
       la facture. #}
    <div class="doc-txt">{{ r.lettre.appel(client_nom) }}</div>
    {% if facture %}
      {% set reference = r.lettre.ecrire('reference', {"n° de l'offre": f.offre_numero ~ '', "date de l'offre": f.offre_cree_le ? f.offre_cree_le|jour : ''}, activite) %}
      <div class="doc-txt">{{ r.lettre.texte('facture_debut', client_nom, activite) }}{% if reference %} {{ reference|phrase }}{% endif %}</div>
    {% else %}
      {# Le texte avant les lignes de l'offre remplace la phrase de Ma marque (D6 A, 2026-11-21). #}
      {% set visite = chantier and chantier.visite ? r.lettre.ecrire('visite', {'date': chantier.visite|date_longue}, activite) : null %}
      {% set lieu = chantier ? r.lettre.ecrire('chantier', {'adresse': chantier.adresse|trim('.', 'right')}, activite) : null %}
      <div class="doc-txt">{% if offre.texte_avant %}{{ offre.texte_avant|nl2br }}{% else %}{{ r.lettre.texte('offre_debut', client_nom, activite) }}{% endif %}{% if visite %} {{ visite|phrase }}{% endif %}{% if lieu %} {{ lieu|phrase }}{% endif %}</div>
    {% endif %}
    {{ b.lignes(_context) }}
    {{ b.totaux(_context) }}
    {{ b.options(_context) }}
    <div class="doc-fin">
      {% if facture %}
        <div class="doc-txt doc-apres">{{ b.phrases_fin(_context, {forme: 'texte', merci: false}) }}</div>
        <div class="doc-txt">{{ r.lettre.texte('facture_fin', client_nom, activite) }}</div>
        {% if qr and (not pdf or (qr_place ?? null) in ['essai', 'bas']) %}<div class="doc-mentions">{{ r.entreprise }}{% if r.ide %} · {{ r.ide }}{% if avec_tva %} TVA{% endif %}{% endif %}</div>{% endif %}
      {% else %}
        <div class="doc-txt doc-apres">{{ b.phrases_fin(_context, {forme: 'texte', non_compris: true}) }}</div>
        {# Le texte après les lignes, avant la formule de politesse, qui reste (D16 A). #}
        {% if offre.texte_apres %}<div class="doc-txt">{{ offre.texte_apres|nl2br }}</div>{% endif %}
        <div class="doc-txt">{{ r.lettre.texte('offre_fin', client_nom, activite) }}</div>
      {% endif %}
      <table class="doc-sign"><tr>
        <td>{{ r.entreprise }}<div class="doc-sig-nom">{{ r.contactNom }}</div></td>
        <td>{% if not facture %}{{ b.accord() }}{% endif %}</td>
      </tr></table>
    </div>
  </div>
{% endblock %}
