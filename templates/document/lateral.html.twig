{% extends 'document/_base.html.twig' %}
{% import 'document/_blocs.html.twig' as b %}
{# Latéral : une colonne de couleur à gauche, sur toute la hauteur de chaque page, porte le logo, les références du
   document et les coordonnées de l'entreprise. #}

{% block fixes %}
  <div class="doc-colonne c-fond">
    <div class="doc-carte">{{ b.logo(_context) }}</div>
    <div class="doc-bloc"><div class="doc-lab">{{ doc_nom }}</div><div class="doc-gros">{{ doc_numero }}</div></div>
    <div class="doc-bloc"><div class="doc-lab">Date</div>{{ doc_date }}</div>
    {% if facture %}<div class="doc-bloc"><div class="doc-lab">Échéance</div>{{ f.echeance|jour }}</div>
    <div class="doc-bloc"><div class="doc-lab">Référence</div>{{ b.ref(_context) }}</div>
    {% else %}<div class="doc-bloc"><div class="doc-lab">Valable jusqu'au</div>{{ valable_jusqu_au }}</div>
    {% if chantier and chantier.adresse %}<div class="doc-bloc"><div class="doc-lab">Chantier</div>{{ chantier.adresse }}</div>{% endif %}{% endif %}
    {% set contact = [r.contactNom, r.telephone, r.courrielContact]|filter(x => x != '') %}
    {% if contact %}<div class="doc-bloc"><div class="doc-lab">Votre contact</div>{% for x in contact %}{{ x }}{% if not loop.last %}<br>{% endif %}{% endfor %}</div>{% endif %}
    <div class="doc-fond"><b>{{ r.entreprise }}</b>{% for l in coord %}<br>{{ l }}{% endfor %}{% if r.ide %}<br>{{ r.ide }}{% if avec_tva %} TVA{% endif %}{% endif %}{% if r.iban and not facture %}<br>IBAN {{ r.iban|iban }}{% endif %}</div>
  </div>
  <table class="doc-pied"><tr><td>&nbsp;</td><td class="n">{{ b.page(_context) }}</td></tr></table>
{% endblock %}

{% block corps %}
  <div class="doc-in">
    {{ b.adresse(_context) }}
    <div class="doc-titre">{{ doc_objet }}</div>
    {{ b.annulee(_context) }}
    {{ b.lignes(_context, {grp: 'c-texte'}) }}
    {{ b.totaux(_context, {tt: 'c-filet'}) }}
    <div class="doc-fin">
      {{ b.conditions(_context, {pile: true}) }}
      {{ b.signatures(_context) }}
    </div>
  </div>
{% endblock %}
