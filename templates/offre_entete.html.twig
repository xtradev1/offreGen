{% extends 'base.html.twig' %}

{% block titre %}Offre {{ offre.numero }} · offreGen{% endblock %}
{% block retour %}<a class="back" href="/offres/{{ offre.id }}">Offre</a>{% endblock %}
{% block entete %}Offre {{ offre.numero }}{% endblock %}

{% macro erreur(erreurs, champ) %}{% if erreurs[champ] is defined %}<span class="err" id="err-{{ champ }}">{{ erreurs[champ] }}</span>{% endif %}{% endmacro %}
{% macro invalide(erreurs, champ) %}{% if erreurs[champ] is defined %} aria-invalid="true" aria-describedby="err-{{ champ }}"{% endif %}{% endmacro %}

{% block contenu %}
  {% import _self as f %}
  {% if erreurs is not empty %}<p class="alerte bad" role="alert">L'offre n'est pas enregistrée&nbsp;: corrigez les champs signalés.</p>{% endif %}
  <form id="entete" method="post" action="/offres/{{ offre.id }}/modifier">
    <input type="hidden" name="_csrf" value="{{ csrf() }}">
    <div class="champ">
      <label for="client_nom">Client</label>
      <input id="client_nom" name="client_nom" value="{{ champs.client_nom }}" maxlength="190" autocomplete="off" placeholder="Madame, Monsieur…"{{ f.invalide(erreurs, 'client_nom') }}>
      {{ f.erreur(erreurs, 'client_nom') }}
    </div>
    <div class="champ">
      <label for="client_adresse">Adresse du client</label>
      <textarea id="client_adresse" name="client_adresse" rows="2" autocomplete="off" placeholder="Rue et numéro&#10;NPA et localité"{{ f.invalide(erreurs, 'client_adresse') }}>{{ champs.client_adresse }}</textarea>
      {{ f.erreur(erreurs, 'client_adresse') }}
    </div>
    <div class="champ">
      <label for="titre">Objet de l'offre</label>
      <input id="titre" name="titre" value="{{ champs.titre }}" maxlength="190" required{{ f.invalide(erreurs, 'titre') }}>
      {{ f.erreur(erreurs, 'titre') }}
    </div>
  </form>
{% endblock %}

{% block actions %}
  <div class="actionbar">
    <a class="btn" href="/offres/{{ offre.id }}">Annuler</a>
    <button class="btn primary" type="submit" form="entete">Enregistrer</button>
  </div>
{% endblock %}
