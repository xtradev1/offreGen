{% extends 'base.html.twig' %}

{# « Plus » (décision D2 de Xavier, 2026-11-15) : ce qui sert rarement sort de la barre du bas. #}
{% block titre %}Plus · {{ nom_application }}{% endblock %}
{% block entete %}Plus{% endblock %}
{% block entete_html %}{% if guide_possible() %}<link rel="stylesheet" href="{{ fichier('/css/guide.css') }}">{% endif %}{% endblock %}

{% block contenu %}
  <nav class="plus" aria-label="Plus">
    <a class="plus-ligne" href="/catalogue">
      <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8 12 3 3 8v8l9 5 9-5z"/><path d="m3 8 9 5 9-5M12 13v8"/></svg>
      <span><b>Catalogue</b><small>Produits, prix et synonymes</small></span></a>
    <a class="plus-ligne" href="/import-catalogue">
      <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M12 18v-6M9 15l3 3 3-3"/></svg>
      <span><b>Importer d'anciennes offres</b><small>Vos produits et vos prix, tirés de vos PDF</small></span></a>
    <a class="plus-ligne" href="/reglages">
      <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1"/><circle cx="15" cy="6" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="17" cy="18" r="2"/></svg>
      <span><b>Réglages</b><small>Entreprise, marque, conditions, TVA</small></span></a>
    <a class="plus-ligne" href="/import" data-importer>
      <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M5 20h14"/></svg>
      <span><b>Importer un enregistrement</b><small>Un fichier audio du téléphone</small></span></a>
    {# « Revoir le guide » (chantier onboarding, lot 3) : il repart de sa première étape, sur « Offres ». #}
    {% if guide_possible() %}
    <form method="post" action="/guide/revoir" class="plus-form">
      <input type="hidden" name="_csrf" value="{{ csrf() }}">
      <button class="plus-ligne" type="submit">
        <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14M12 17h.01"/></svg>
        <span><b>Revoir le guide</b><small>Le micro, les conseils, la première offre</small></span></button>
    </form>
    {% endif %}
    {% set role = role_equipe() %}
    {# « Demander un appel », pendant toute la démo et tout l'essai (K1 de l'administration ; chantier onboarding, E1). #}
    {% if not role and (demo() or essai()) %}
    <a class="plus-ligne" href="/demander-un-appel">
      <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>
      <span><b>Demander un appel</b><small>Votre numéro, le moment qui vous convient</small></span></a>
    {% endif %}
    {# L'administration n'existe que pour l'équipe (G1, 2026-11-17 ; E1, 2026-11-19). #}
    {% if role %}
    <a class="plus-ligne" href="/admin">
      <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h13l-3-3M17 17H4l3 3"/></svg>
      <span><b>{{ role.espace }}</b><small>Artisans, démos, suivi</small></span></a>
    {% endif %}
  </nav>
  {% include '_compte.html.twig' %}
{% endblock %}

{% block onglets %}{% include '_onglets.html.twig' with {actif: 'plus'} %}{% endblock %}
