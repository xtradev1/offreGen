{% extends 'base.html.twig' %}

{# Sans JavaScript, la page se recharge ; avec, app.js fait avancer les étapes chaque seconde. #}
{% block entete_html %}{% if not fini %}<noscript><meta http-equiv="refresh" content="5"></noscript>{% endif %}{% endblock %}
{% block titre %}Préparation de l'offre · offreGen{% endblock %}
{% block retour %}<a class="back" href="/">Offres</a>{% endblock %}
{% block entete %}Préparation de l'offre{% endblock %}

{% block contenu %}
  <p class="muted">Fichier&nbsp;: {{ e.nom_origine }}</p>
  {% if echec %}
    <p class="alerte bad" role="alert">La préparation a échoué après plusieurs essais. Importez le fichier une nouvelle fois&nbsp;; si l'échec revient, écrivez-nous.</p>
  {% endif %}
  <div class="suivi">
    {% include '_etapes.html.twig' with {uuid: fini ? '' : e.uuid} %}
  </div>
  {% if not fini %}
    <p class="muted petit centre">Vous pouvez fermer l'application&nbsp;: un courriel vous préviendra quand l'offre sera prête.</p>
  {% endif %}
{% endblock %}

{% block actions %}
  <div class="actionbar">
    {% if e.statut == 'pret' and e.offre_id %}
      <a class="btn primary" href="/offres/{{ e.offre_id }}">Voir l'offre</a>
    {% elseif echec %}
      <a class="btn primary" href="/import">Importer à nouveau</a>
    {% else %}
      <a class="btn" href="/">Revenir aux offres</a>
    {% endif %}
  </div>
{% endblock %}
