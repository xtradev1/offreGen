{% extends 'base.html.twig' %}

{# Sommaire des réglages (choix de Xavier du 2026-11-12) : une ligne par rubrique, avec son résumé et
   « à compléter » si un champ attendu manque. Chaque rubrique s'ouvre seule (/reglages/{rubrique}). #}
{% block titre %}Réglages · offreGen{% endblock %}
{% block entete %}Réglages{% endblock %}
{% block ecran_classe %} gris{% endblock %}

{% set icones = {
  entreprise: '<path d="M4 21V5l8-2v18M12 8h8v13M4 21h16M8 8h.01M8 12h.01M8 16h.01M16 12h.01M16 16h.01"/>',
  marque: '<path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.6-.9 1.2-1.8-.5-1-.1-2.2 1.1-2.2H17a4 4 0 0 0 4-4c0-5.5-4-10-9-10z"/><circle cx="7.5" cy="11" r="1"/><circle cx="10.5" cy="7.5" r="1"/><circle cx="15" cy="8" r="1"/>',
  conditions: '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h6"/>',
  tva: '<path d="M19 5 5 19"/><circle cx="7" cy="7" r="2.5"/><circle cx="17" cy="17" r="2.5"/>'
} %}

{% block contenu %}
  <p class="etat-reglages">
    <span class="points" aria-hidden="true">{% for r in rubriques %}<i{% if r.complete %} class="ok"{% endif %}></i>{% endfor %}</span>
    <span>{{ completes }} rubrique{{ completes > 1 ? 's' : '' }} sur {{ rubriques|length }} complète{{ completes > 1 ? 's' : '' }}</span>
  </p>
  {% for cle, r in rubriques %}
    <a class="rubrique" href="/reglages/{{ cle }}">
      <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ icones[cle]|raw }}</svg></span>
      <span class="corps"><b>{{ r.titre }}{% if not r.complete %} <span class="badge manque">à compléter</span>{% endif %}</b><small>{{ r.resume }}</small></span>
      <span class="fl" aria-hidden="true">›</span>
    </a>
  {% endfor %}

  <form class="compte" method="post" action="/deconnexion">
    <input type="hidden" name="_csrf" value="{{ csrf() }}">
    <span class="muted">Compte&nbsp;: {{ courriel }}{% if demo %} (démonstration){% endif %}</span>
    <button class="lien" type="submit">Se déconnecter</button>
  </form>
{% endblock %}

{% block onglets %}{% include '_onglets.html.twig' with {actif: 'reglages'} %}{% endblock %}
