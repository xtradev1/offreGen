{% extends 'base.html.twig' %}

{% block titre %}Réglages · offreGen{% endblock %}
{% block entete %}Réglages{% endblock %}
{% block ecran_classe %} gris{% endblock %}

{% macro erreur(erreurs, champ) %}{% if erreurs[champ] is defined %}<span class="err" id="err-{{ champ }}">{{ erreurs[champ] }}</span>{% endif %}{% endmacro %}
{% macro invalide(erreurs, champ) %}{% if erreurs[champ] is defined %} aria-invalid="true" aria-describedby="err-{{ champ }}"{% endif %}{% endmacro %}

{% block contenu %}
  {% import _self as f %}
  {% if erreurs is not empty %}<p class="alerte bad" role="alert">Les réglages ne sont pas enregistrés&nbsp;: corrigez les champs signalés.</p>{% endif %}
  <form id="reglages" method="post" action="/reglages">
    <input type="hidden" name="_csrf" value="{{ csrf() }}">
    {# En premier : c'est ce qui change le plus souvent. Des boutons radio habillés en pastilles : un toucher
       choisit, « Autre » ouvre la saisie (CSS :has, sans JavaScript). La phrase de l'offre se construit
       des choix, dans Reglages::conditionsPaiement(). #}
    <div class="card">
      <h6>Conditions de l'offre</h6>
      <fieldset class="groupe choix">
        <legend>Offre valable</legend>
        <div class="puces quatre">
          {% for j in validites %}<label class="puce"><input type="radio" name="validite_choix" value="{{ j }}"{% if champs.validite_choix == j ~ '' %} checked{% endif %}>{{ j }}&nbsp;jours</label>{% endfor %}
          <label class="puce"><input type="radio" name="validite_choix" value="autre"{% if champs.validite_choix == 'autre' %} checked{% endif %}>Autre</label>
        </div>
        <div class="champ si-autre">
          <label for="validite_jours">Nombre de jours, de 1 à 365</label>
          <input id="validite_jours" name="validite_jours" value="{{ champs.validite_jours }}" inputmode="numeric" autocomplete="off"{{ f.invalide(erreurs, 'validite_jours') }}>
        </div>
        {{ f.erreur(erreurs, 'validite_jours') }}
      </fieldset>

      <fieldset class="groupe paiement" data-paiement>
        <legend>Paiement</legend>
        <div class="puces trois">
          {% for type, libelle in types %}<label class="puce"><input type="radio" name="paiement_type" value="{{ type }}"{% if champs.paiement_type == type %} checked{% endif %}>{{ libelle }}</label>{% endfor %}
        </div>
        {{ f.erreur(erreurs, 'paiement_type') }}
        <div class="choix si-delai">
          <div class="puces cinq">
            {% for j in delais %}<label class="puce"><input type="radio" name="paiement_jours_choix" value="{{ j }}"{% if champs.paiement_jours_choix == j ~ '' %} checked{% endif %}>{{ j }}&nbsp;j</label>{% endfor %}
            <label class="puce"><input type="radio" name="paiement_jours_choix" value="autre"{% if champs.paiement_jours_choix == 'autre' %} checked{% endif %}>Autre</label>
          </div>
          <div class="champ si-autre">
            <label for="paiement_jours">Nombre de jours, de 1 à 120</label>
            <input id="paiement_jours" name="paiement_jours" value="{{ champs.paiement_jours }}" inputmode="numeric" autocomplete="off"{{ f.invalide(erreurs, 'paiement_jours') }}>
          </div>
          {{ f.erreur(erreurs, 'paiement_jours') }}
        </div>
        <div class="choix si-acomptes">
          <div class="puces quatre">
            {% for a in acomptes %}<label class="puce"><input type="radio" name="paiement_acomptes_choix" value="{{ a }}"{% if champs.paiement_acomptes_choix == a %} checked{% endif %}>{{ a|replace({',': ' / '}) }}</label>{% endfor %}
            <label class="puce"><input type="radio" name="paiement_acomptes_choix" value="autre"{% if champs.paiement_acomptes_choix == 'autre' %} checked{% endif %}>Autre</label>
          </div>
          <div class="champ si-autre">
            <label for="paiement_acomptes">Acomptes en %, de 2 à 4, qui font 100</label>
            <input id="paiement_acomptes" name="paiement_acomptes" value="{{ champs.paiement_acomptes }}" placeholder="30, 30, 40" autocomplete="off"{{ f.invalide(erreurs, 'paiement_acomptes') }}>
          </div>
          {{ f.erreur(erreurs, 'paiement_acomptes') }}
        </div>
        <p class="phrase">Sur l'offre&nbsp;: «&nbsp;<span data-phrase>{{ phrase }}</span>&nbsp;»</p>
      </fieldset>
      <label class="check"><input type="checkbox" name="arrondi" value="1"{% if arrondi %} checked{% endif %}>
        <span>Arrondir le total aux 5 centimes<small>L'écart s'affiche sur la ligne «&nbsp;Arrondi&nbsp;».</small></span></label>
      <p class="muted petit">Changer la TVA ou l'arrondi change aussi le total des offres déjà faites.</p>
    </div>

    {# Ma marque, en trois touchers : le logo (envoyé à part, formulaire form-logo, sa couleur est proposée
       d'office), la couleur, le modèle. La CSP refuse les styles en ligne : pastilles dessinées en SVG. #}
    <div class="card" id="marque">
      <h6>Ma marque, sur vos documents</h6>
      <fieldset class="groupe">
        <legend>1. Logo</legend>
        <div class="logo-ligne">
          {% if marque.logo %}<img class="logo-apercu" src="/reglages/logo?v={{ marque.logo }}" alt="Votre logo">{% else %}<span class="muted petit">Aucun logo</span>{% endif %}
          <label class="btn" for="logo">{{ marque.logo ? 'Changer' : 'Choisir le logo' }}</label>
          <input class="cache" id="logo" name="logo" type="file" accept="image/png,image/jpeg" form="form-logo" data-envoi-auto>
          {% if marque.logo %}<button class="lien" type="submit" form="form-logo-retirer">Retirer</button>{% endif %}
        </div>
        <noscript><button class="btn" type="submit" form="form-logo">Envoyer le logo choisi</button></noscript>
        <p class="muted petit">PNG ou JPEG, 5&nbsp;Mo au plus. Sa couleur devient celle de vos documents.</p>
      </fieldset>
      <fieldset class="groupe choix">
        <legend>2. Couleur</legend>
        <div class="teintes">
          {% for t in teintes %}
            <label class="teinte" title="{{ t == marque.couleurDuLogo ? 'Couleur du logo' : t }}"><input type="radio" name="couleur_choix" value="{{ t }}"{% if champs.couleur_choix == t %} checked{% endif %}>
              <svg viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="5" fill="{{ t }}"/></svg><span class="cache">{{ t == marque.couleurDuLogo ? 'Couleur du logo' : 'Couleur ' ~ t }}</span></label>
          {% endfor %}
          <label class="puce teinte-autre"><input type="radio" name="couleur_choix" value="autre"{% if champs.couleur_choix == 'autre' %} checked{% endif %}>Autre</label>
        </div>
        <div class="champ si-autre">
          <label for="couleur">Votre couleur</label>
          <input id="couleur" name="couleur" type="color" value="{{ champs.couleur|default('#1D4E89')|lower }}"{{ f.invalide(erreurs, 'couleur') }}>
        </div>
        {{ f.erreur(erreurs, 'couleur') }}
      </fieldset>
      <fieldset class="groupe">
        <legend>3. Modèle</legend>
        <div class="modeles">
          {% for cle, nom in modeles %}
            <label class="modele"><input type="radio" name="modele" value="{{ cle }}"{% if champs.modele == cle %} checked{% endif %}>
              <img src="/img/modeles/{{ cle }}.jpg" alt="" width="180" height="255"><span>{{ nom }}</span></label>
          {% endfor %}
        </div>
      </fieldset>
    </div>

    <div class="card">
      <h6>Entreprise, en tête de l'offre</h6>
      <div class="champ">
        <label for="entreprise">Nom</label>
        <input id="entreprise" name="entreprise" value="{{ champs.entreprise }}" maxlength="190" required autocomplete="organization"{{ f.invalide(erreurs, 'entreprise') }}>
        {{ f.erreur(erreurs, 'entreprise') }}
      </div>
      <div class="champ">
        <label for="adresse">Adresse</label>
        <textarea id="adresse" name="adresse" rows="2" placeholder="Rue de l'Exemple 12&#10;2800 Delémont" autocomplete="street-address"{{ f.invalide(erreurs, 'adresse') }}>{{ champs.adresse }}</textarea>
        {{ f.erreur(erreurs, 'adresse') }}
      </div>
      <div class="duo">
        <div class="champ">
          <label for="telephone">Téléphone</label>
          <input id="telephone" name="telephone" value="{{ champs.telephone }}" inputmode="tel" autocomplete="tel"{{ f.invalide(erreurs, 'telephone') }}>
          {{ f.erreur(erreurs, 'telephone') }}
        </div>
        <div class="champ">
          <label for="ide">Numéro IDE</label>
          <input id="ide" name="ide" value="{{ champs.ide }}" placeholder="CHE-123.456.789" autocomplete="off"{{ f.invalide(erreurs, 'ide') }}>
          {{ f.erreur(erreurs, 'ide') }}
        </div>
      </div>
      <div class="champ">
        <label for="courriel_contact">Courriel pour les clients</label>
        <input id="courriel_contact" name="courriel_contact" type="email" value="{{ champs.courriel_contact }}" inputmode="email" autocomplete="email"{{ f.invalide(erreurs, 'courriel_contact') }}>
        {{ f.erreur(erreurs, 'courriel_contact') }}
      </div>
      <p class="muted">Compte&nbsp;: {{ courriel }}{% if demo %} (démonstration){% endif %}</p>
    </div>

    <div class="card">
      <h6>TVA</h6>
      <label class="radio"><input type="radio" name="tva" value="810"{% if champs.tva == '810' %} checked{% endif %}>
        <span>Assujetti, 8,1&nbsp;%<small>La TVA s'ajoute au sous-total de chaque offre.</small></span></label>
      <label class="radio"><input type="radio" name="tva" value="0"{% if champs.tva == '0' %} checked{% endif %}>
        <span>Non assujetti<small>Moins de 100&nbsp;000 francs de chiffre d'affaires par an&nbsp;: l'offre ne porte pas de TVA.</small></span></label>
      {{ f.erreur(erreurs, 'tva') }}
    </div>

  </form>

  {# Formulaires du logo, hors du formulaire principal (pas de formulaire dans un formulaire) : leurs champs
     et boutons, dans la carte « Ma marque », s'y rattachent par l'attribut form. #}
  <form id="form-logo" method="post" action="/reglages/logo" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="{{ csrf() }}"></form>
  <form id="form-logo-retirer" method="post" action="/reglages/logo/retirer"><input type="hidden" name="_csrf" value="{{ csrf() }}"></form>

  <form class="pied" method="post" action="/deconnexion">
    <input type="hidden" name="_csrf" value="{{ csrf() }}">
    <button class="lien" type="submit">Se déconnecter</button>
  </form>
{% endblock %}

{% block actions %}
  <div class="actionbar"><button class="btn primary" type="submit" form="reglages">Enregistrer</button></div>
{% endblock %}

{% block onglets %}{% include '_onglets.html.twig' with {actif: 'reglages'} %}{% endblock %}
