{% extends 'base.html.twig' %}

{% block titre %}{{ offre.titre }} · offreGen{% endblock %}
{% block retour %}<a class="back" href="/">Offres</a>{% endblock %}
{% block entete %}Offre {{ offre.numero }}{% endblock %}

{% block contenu %}
  {# Le client ouvre « Client de l'offre » par-dessus l'offre ; l'objet ouvre son écran. #}
  {# Client et objet en cartes de 60 px, touchées pour les changer (décision D3, 2026-11-15). #}
  <div class="ohead">
    <a class="who carte-lien" href="/offres/{{ offre.id }}/client" data-en-feuille><span>{% if offre.client_nom %}<b>{{ offre.client_nom }}</b>{% if offre.client_adresse %}<small>{{ offre.client_adresse|replace({"\n": ', '}) }}</small>{% endif %}{% if offre.client_id is null %}<span class="etiquette nouveau">nouveau client, à confirmer</span>{% endif %}{% else %}<span class="manque-client">Choisir le client</span>{% endif %}</span></a>
    <a class="t carte-lien" href="/offres/{{ offre.id }}/modifier"><span><b>{{ offre.titre }}</b><small>Objet de l'offre</small></span></a>
    {% if factures is not empty %}<span class="factures-offre">{% for f in factures %}<a class="etiquette facture{% if f.statut == 'annulee' %} annulee{% endif %}" href="/factures/{{ f.id }}">Facture {{ f.numero }}</a>{% endfor %}</span>{% endif %}
    {% set a_relire = 0 %}
    {% for g in groupes %}{% for r in g.lignes %}{% if r.l.a_verifier or r.l.prix_centimes == 0 %}{% set a_relire = a_relire + 1 %}{% endif %}{% endfor %}{% endfor %}
    <span class="meta"><span class="status pret">{{ a_relire > 0 ? 'À relire' : 'Prête' }}</span><span class="muted" data-sauvegarde>{% if offre.modifiee_le %}Enregistrée le {{ offre.modifiee_le|date_locale }}{% else %}Créée le {{ offre.cree_le|date_locale }}{% endif %}</span></span>
  </div>

  {% include '_lignes.html.twig' with {base: '/offres/' ~ offre.id, modifiable: true, vide: "Aucun poste dans cette offre. « Ajouter », en bas, en ajoute un."} %}

  <div class="totals">
    <div class="r"><span>Sous-total{% if tva > 0 %} HT{% endif %}</span><span>{{ totaux.ht|chf }}</span></div>
    {% if tva > 0 %}<div class="r"><span>TVA {{ tva|taux }}</span><span>{{ totaux.tva|chf }}</span></div>{% endif %}
    {% if totaux.arrondi != 0 %}<div class="r"><span>Arrondi</span><span>{{ totaux.arrondi|chf }}</span></div>{% endif %}
    <div class="r grand"><span>Total{% if tva > 0 %} TTC{% endif %}</span><span>{{ totaux.ttc|chf }}</span></div>
  </div>
  <p class="muted petit">Touchez une quantité ou un prix pour le corriger, une désignation pour la ligne entière.</p>
{% endblock %}

{% block actions %}
  {% include '_feuille.html.twig' with {options: {rafraichir: '.ohead'}} %}
  {# Décision D3 (2026-11-15) : le total reste visible en bas ; l'action principale suit l'état de l'offre.
     Une ligne à vérifier ou sans prix demande d'abord la relecture, une à la fois (D5). #}
  {% set a_relire = 0 %}
  {% for g in groupes %}{% for r in g.lignes %}{% if r.l.a_verifier or r.l.prix_centimes == 0 %}{% set a_relire = a_relire + 1 %}{% endif %}{% endfor %}{% endfor %}
  <div class="totalbar" data-total-fixe><span>Total{% if tva > 0 %} TTC{% endif %}</span><b>{{ totaux.ttc|chf }}</b></div>
  <div class="actionbar">
    <a class="btn carre" href="/offres/{{ offre.id }}/ajouter" aria-label="Ajouter une ligne">
      <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></a>
    {% if a_relire > 0 %}
      <a class="btn primary grand" href="/offres/{{ offre.id }}/relire">
        <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Relire {{ a_relire }} ligne{{ a_relire > 1 ? 's' : '' }}</a>
    {% else %}
      <a class="btn primary grand" href="/offres/{{ offre.id }}/document">Générer l'offre
        <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></a>
    {% endif %}
  </div>
{% endblock %}

{% block onglets %}{% include '_onglets.html.twig' with {actif: 'offres'} %}{% endblock %}
