{# Fenêtre qui monte par-dessus la liste : app.js (fichesEnFenetre) y charge la page d'un lien data-en-feuille ;
   sans JavaScript, le lien ouvre cette page seule. rafraichir : ce qui se recharge à la fermeture ;
   lignes et prefixe : la ligne modifiée qui s'éclaire ; recherche : le champ qui refiltre la liste. #}
<div class="feuille-fond" data-feuille-page hidden{% for cle, valeur in options ?? {} %} data-{{ cle }}="{{ valeur }}"{% endfor %}>
  <div class="feuille cadre" role="dialog" aria-modal="true" aria-labelledby="titre-fiche" tabindex="-1">
    <div class="poignee" aria-hidden="true"></div>
    <div class="sh-h"><h2 id="titre-fiche" data-feuille-titre></h2>
      <button class="x" type="button" data-fermer aria-label="Fermer"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
    <div class="sh-corps" data-feuille-corps></div>
    <div class="sh-pied" data-feuille-pied></div>
  </div>
</div>
