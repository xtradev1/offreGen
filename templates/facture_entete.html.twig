{% extends 'base.html.twig' %}

{# Numéro, date et échéance d'un brouillon ; sa suppression, qui libère le numéro. #}
{% block titre %}Facture {{ f.numero }} · offreGen{% endblock %}
{% block retour %}<a class="back" href="/factures/{{ f.id }}">Facture</a>{% endblock %}
{% block entete %}Facture {{ f.numero }}{% endblock %}

{% macro erreur(erreurs, champ) %}{% if erreurs[champ] is defined %}<span class="err" id="err-{{ champ }}">{{ erreurs[champ] }}</span>{% endif %}{% endmacro %}
{% macro invalide(erreurs, champ) %}{% if erreurs[champ] is defined %} aria-invalid="true" aria-describedby="err-{{ champ }}"{% endif %}{% endmacro %}

{% block contenu %}
  {% import _self as x %}
  {% if erreurs is not empty %}<p class="alerte bad" role="alert">La facture n'est pas enregistrée&nbsp;: corrigez les champs signalés.</p>{% endif %}
  <form id="entete" method="post" action="/factures/{{ f.id }}/modifier">
    <input type="hidden" name="_csrf" value="{{ csrf() }}">
    <div class="champ">
      <label for="numero">Numéro</label>
      <input id="numero" name="numero" value="{{ champs.numero }}" maxlength="20" required autocomplete="off" spellcheck="false"{{ x.invalide(erreurs, 'numero') }}>
      {{ x.erreur(erreurs, 'numero') }}
    </div>
    <div class="duo">
      <div class="champ">
        <label for="date">Date</label>
        <input id="date" name="date" type="date" value="{{ champs.date }}" required{{ x.invalide(erreurs, 'date') }}>
        {{ x.erreur(erreurs, 'date') }}
      </div>
      <div class="champ">
        <label for="echeance">Échéance</label>
        <input id="echeance" name="echeance" type="date" value="{{ champs.echeance }}" required{{ x.invalide(erreurs, 'echeance') }}>
        {{ x.erreur(erreurs, 'echeance') }}
      </div>
    </div>
  </form>
  <p class="muted petit">Le client et l'objet viennent de l'offre n°&nbsp;{{ f.offre_numero }}. Pour en changer, supprimez ce brouillon, corrigez l'offre, puis facturez-la de nouveau.</p>
  <form class="pied" method="post" action="/factures/{{ f.id }}/supprimer">
    <input type="hidden" name="_csrf" value="{{ csrf() }}">
    <button class="lien" type="submit">Supprimer ce brouillon</button>
  </form>
{% endblock %}

{% block actions %}
  <div class="actionbar">
    <a class="btn" href="/factures/{{ f.id }}">Annuler</a>
    <button class="btn primary" type="submit" form="entete">Enregistrer</button>
  </div>
{% endblock %}
