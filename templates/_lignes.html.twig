{# Les lignes d'une offre ou d'une facture, rangées par catégorie. « base » : /offres/ID ou /factures/ID.
   « modifiable » : faux pour une facture émise ou annulée, qui ne montre plus aucun champ.
   « libre » : faux sur une facture, où l'étiquette « Ligne libre » n'apprend rien au lecteur. #}
<div class="rows une{% if not modifiable %} figees{% endif %}">
  {% for g in groupes %}
    {# Par pièce (sous-chantier 28) : le sous-total au titre, « Renommer » pour une pièce (P5), pas pour « Général ». #}
    <div class="cat"><h5>{{ g.nom }}{% if g.par_piece ?? false %} <span class="st">{{ g.total|montant }}</span>{% if modifiable and g.piece is not null %} <a class="renommer" href="{{ base }}/pieces?nom={{ g.piece|url_encode }}">Renommer</a>{% endif %}{% endif %}</h5><span class="ch">Qté</span><span class="ch">Prix</span><span class="ch">Total</span><span></span></div>
    {% for r in g.lignes %}
      {% set l = r.l %}
      {% set lien = base ~ '/lignes/' ~ l.id %}
      {# Ligne offerte (D1, 2026-11-21) : elle compte 0 ; prix gardé et barré, ou 0 pour « Offert » seul. #}
      {% set offerte = l.offerte ?? false %}
      {% set manque = l.prix_centimes == 0 and not offerte %}
      <div class="row{% if manque %} miss{% elseif l.a_verifier %} flag{% endif %}" id="l{{ l.id }}"{% if modifiable %} data-glisse-ligne{% endif %}>
        {% if modifiable %}
          <a class="nm" href="{{ lien }}" data-en-feuille-pc>{{ l.designation }}{% if l.produit_id is null and (libre ?? true) %}<small><span class="tag">Ligne libre</span></small>{% endif %}</a>
          <form class="q" method="post" action="{{ lien }}">
            <input type="hidden" name="_csrf" value="{{ csrf() }}">
            <input class="saisie" name="quantite" value="{{ l.quantite_milliemes|saisie_quantite }}" inputmode="decimal" autocomplete="off" required aria-label="Quantité, {{ l.designation }}" data-envoi-change>
            <span class="u">{{ l.unite }}</span>
          </form>
          <form class="p" method="post" action="{{ lien }}">
            <input type="hidden" name="_csrf" value="{{ csrf() }}">
            <input class="saisie{% if manque %} manque{% elseif offerte and l.prix_centimes > 0 %} barre{% endif %}" name="prix" value="{{ l|saisie_prix_ligne }}" inputmode="decimal" autocomplete="off" placeholder="Prix" aria-label="Prix unitaire en francs, {{ l.designation }}" data-envoi-change>
          </form>
          {% if offerte %}<div class="tt offert">Offert</div>{% else %}<div class="tt">{% if not manque %}{{ r.total|montant }}{% endif %}</div>{% endif %}
          <form method="post" action="{{ lien }}/supprimer">
            <input type="hidden" name="_csrf" value="{{ csrf() }}">
            <button class="del" type="submit" aria-label="Supprimer la ligne {{ l.designation }}"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg></button>
          </form>
        {% else %}
          <span class="nm">{{ l.designation }}</span>
          <span class="q fige">{{ l.quantite_milliemes|quantite }}&nbsp;<span class="u">{{ l.unite }}</span></span>
          <span class="p fige{% if offerte and l.prix_centimes > 0 %} barre{% endif %}">{% if not manque and not (offerte and l.prix_centimes == 0) %}{{ l.prix_centimes|montant }}{% endif %}</span>
          {% if offerte %}<div class="tt offert">Offert</div>{% else %}<div class="tt">{% if not manque %}{{ r.total|montant }}{% endif %}</div>{% endif %}
          <span></span>
        {% endif %}
        {# Ligne hors catalogue d'une offre (4a et 4b, 2026-11-20) : une bande sous la ligne ouvre la fiche « Mettre au
           catalogue » (nouveau produit, ou produit déjà au catalogue). #}
        {% if modifiable and (ranger ?? false) and l.produit_id is null %}
          <a class="vers-catalogue" href="{{ lien }}/catalogue" data-en-feuille>
            <span class="vc-ic"><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 21a2 2 0 0 1 2-2h13v2"/><path d="M12 7v6M9 10h6"/></svg></span><span class="vc-tx"><b>Pas dans votre catalogue</b><small>Ajoutez-le pour la prochaine dictée</small></span><svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></a>
        {% endif %}
        {# Prix dicté pour un produit du catalogue (Xavier, 2026-11-17) : le catalogue reste par défaut ; « Prendre » met le
           prix dicté, puis la question du catalogue. Les lignes de facture n'en ont pas. #}
        {% set dicte = l.prix_dicte_centimes ?? null %}
        {% if modifiable and dicte is not null and l.produit_id is not null %}
          {% if l.prix_centimes != dicte %}
            <form class="note prix-dit" method="post" action="{{ lien }}/prix-dicte">
              <input type="hidden" name="_csrf" value="{{ csrf() }}">
              <span>Prix dicté {{ dicte|montant }}, catalogue {{ (l.prix_catalogue ?? l.prix_centimes)|montant }}</span><button class="okbtn" type="submit"><span>Prendre {{ dicte|montant }}</span></button>
            </form>
          {% elseif (l.prix_catalogue ?? null) is not null and l.prix_catalogue != dicte %}
            <form class="note prix-dit" method="post" action="{{ lien }}/prix-dicte/catalogue">
              <input type="hidden" name="_csrf" value="{{ csrf() }}">
              <span>Mettre aussi {{ dicte|montant }} au catalogue ?</span><button class="okbtn" type="submit" name="choix" value="oui"><span>Oui</span></button><button class="okbtn" type="submit" name="choix" value="non"><span>Non</span></button>
            </form>
          {% endif %}
        {% endif %}
        {% if manque %}
          <div class="note bad"><span>Prix manquant</span></div>
        {% elseif l.a_verifier %}
          <form class="note warn" method="post" action="{{ lien }}/juste">
            <input type="hidden" name="_csrf" value="{{ csrf() }}">
            <span>À vérifier</span><button class="okbtn" type="submit"><span>C'est juste</span></button>
          </form>
        {% endif %}
      </div>
    {% endfor %}
  {% else %}
    <p class="vide">{{ vide }}</p>
  {% endfor %}
</div>
