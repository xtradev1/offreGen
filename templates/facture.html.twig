{% extends 'base.html.twig' %}

{# Le brouillon d'une facture (maquette 25, E5) : il sert seulement à corriger des lignes (quantités réelles, travaux
   en plus) ; il prend son numéro à la création. « Créer la facture » le rend définitif sans page de confirmation (E3)
   et ouvre son PDF. Sur PC, le document suit à côté des lignes (E8). Une facture émise ou annulée ne passe plus par
   ici : elle se voit en PDF (FactureControleur::afficher). #}
{% block titre %}Brouillon de facture · {{ nom_application }}{% endblock %}
{% block retour %}<a class="back" href="/offres/{{ f.offre_id }}">Offre {{ f.offre_numero }}</a>{% endblock %}
{% block entete %}Brouillon de facture{% endblock %}

{% block contenu %}
  <div class="ohead">
    <span class="who"><b>{{ f.client_nom }}</b>{% if f.client_adresse %}, {{ f.client_adresse|replace({"\n": ', '}) }}{% endif %}
      · <a class="lien-offre" href="/offres/{{ f.offre_id }}">selon offre n°&nbsp;{{ f.offre_numero }}</a></span>
    <a class="t" href="/factures/{{ f.id }}/modifier">{{ f.titre }}</a>
    <span class="meta"><span class="status pret">{{ f.genre == 'acompte' ? 'Acompte' : 'Facture finale' }}, brouillon</span>
      <span class="muted">N°&nbsp;{{ f.numero ?? numero_prevu ~ ' à la création' }} · datée du {{ f.date_facture|jour }}, échéance le {{ f.echeance|jour }}</span>
      <button class="btn pc-seul doc-cote" type="button" data-doc-cote="/factures/{{ f.id }}/document" data-doc-cote-toujours aria-pressed="false" hidden>Document à côté</button></span>
  </div>
  {% if manque > 0 %}<p class="alerte bad">{{ manque }} ligne{{ manque > 1 ? 's' : '' }} sans prix&nbsp;: à compléter avant de créer la facture.</p>{% endif %}

  {% include '_lignes.html.twig' with {base: '/factures/' ~ f.id, modifiable: true, libre: false, vide: "Aucune ligne. « + », en bas, en ajoute une."} %}
  {% include '_ajout_pc.html.twig' with {base: '/factures/' ~ f.id} %}

  <div class="totals">
    {% set avec_tva = montants.par_taux|filter(g => g.taux > 0)|length > 0 %}
    <div class="r"><span>Sous-total{% if avec_tva %} HT{% endif %}</span><span>{{ montants.ht|chf }}</span></div>
    {% if montants.par_taux|length > 1 %}{% for g in montants.par_taux %}<div class="r"><span>TVA {{ g.taux|taux }} sur {{ g.ht|chf }}</span><span>{{ g.tva|chf }}</span></div>{% endfor %}{% elseif avec_tva %}<div class="r"><span>TVA {{ montants.par_taux[0].taux|taux }}</span><span>{{ montants.tva|chf }}</span></div>{% endif %}
    {% if montants.arrondi != 0 %}<div class="r"><span>Arrondi</span><span>{{ montants.arrondi|chf }}</span></div>{% endif %}
    {% if montants.deja > 0 %}
      <div class="r"><span>Total{% if avec_tva %} TTC{% endif %}</span><span>{{ montants.ttc|chf }}</span></div>
      <div class="r"><span>Acomptes déjà facturés</span><span>−&nbsp;{{ montants.deja|chf }}</span></div>
      <div class="r grand"><span>À payer</span><span data-a-payer>{{ montants.a_payer|chf }}</span></div>
    {% else %}
      <div class="r grand"><span>Total{% if avec_tva %} TTC{% endif %}</span><span data-a-payer>{{ montants.ttc|chf }}</span></div>
    {% endif %}
  </div>
  <p class="muted petit">Corrigez les quantités réelles, ajoutez les travaux en plus. L'offre ne change pas.</p>
  <a class="lien-apercu mobile-seul" href="/factures/{{ f.id }}/document">Voir l'aperçu de la facture</a>
  <form id="creer-facture" method="post" action="/factures/{{ f.id }}/emettre">
    <input type="hidden" name="_csrf" value="{{ csrf() }}">
  </form>
{% endblock %}

{% block actions %}
  {% include '_feuille.html.twig' with {options: {recharger: '1'}} %}
  <div class="actionbar avec-phrase">
    <a class="btn ajout" href="/factures/{{ f.id }}/ajouter" aria-label="Ajouter une ligne" data-en-feuille>
      <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>Ligne</a>
    <button class="btn primary grand" type="submit" form="creer-facture">Créer la facture</button>
    <p class="phrase">{% if raisons is not empty %}{{ raisons|first }}{% else %}{{ montants.a_payer|chf }} à payer. Elle devient définitive et prend le n°&nbsp;{{ f.numero ?? numero_prevu }}&nbsp;; son PDF s'ouvre, prêt à envoyer.{% endif %}</p>
  </div>
{% endblock %}

{% block onglets %}{% include '_onglets.html.twig' with {actif: 'factures'} %}{% endblock %}
