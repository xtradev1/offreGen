# Modèle du fichier .env, à copier en .env sur chaque environnement. Le .env n'est jamais versionné.
# Sans .env, l'application se croit en production : erreurs détaillées coupées.
APP_ENV=dev
# Adresse de l'application, pour les liens des courriels.
APP_URL=http://localhost:8000
# 0 coupe le traitement lancé juste après l'import : seul cron (bin/traiter-file) avance alors.
TRAITEMENT_IMMEDIAT=1

# Base de données. En local : DB_SOCKET ; chez l'hébergeur : DB_HOTE et DB_PORT.
# La base de test se règle dans .env.test.local (DB_NOM=offregen_test), ignoré lui aussi.
DB_SOCKET=
DB_HOTE=
DB_PORT=3306
DB_NOM=offregen_dev
# Utilisateur d'application : SELECT, INSERT, UPDATE, DELETE seulement.
DB_UTILISATEUR=offregen_app
DB_MOT_DE_PASSE=
# Transcription et extraction. « factice » (ou vide) : rien n'est envoyé, l'offre est inventée.
# « api » : protocole d'Infomaniak. En local, le Whisper de outils/ia-locale et l'Ollama de Windows ;
# sur le serveur, les mêmes clés avec l'adresse, le produit et le jeton d'Infomaniak.
TRANSCRIPTION=factice
# Local : http://127.0.0.1:8090 ; Infomaniak : https://api.infomaniak.com
TRANSCRIPTION_URL=http://127.0.0.1:8090
# Local : 0 ; Infomaniak : numéro du produit AI Tools (GET /1/ai)
TRANSCRIPTION_PRODUIT=0
TRANSCRIPTION_CLE=
TRANSCRIPTION_MODELE=whisper
EXTRACTION=factice
# Local : http://<passerelle WSL>:11434/v1 (outils/ia-locale/demarrer.sh la corrige) ;
# Infomaniak : https://api.infomaniak.com/2/ai/<produit>/openai/v1
EXTRACTION_URL=http://172.25.96.1:11434/v1
EXTRACTION_CLE=
# Local : offregen-qwen3.8 (outils/ia-locale/Modelfile) ; Infomaniak : nom du modèle Qwen dans GET /1/ai/models
EXTRACTION_MODELE=offregen-qwen3.8
# 1 : demande au modèle de répondre sans raisonnement (plus rapide). 0 si le service refuse le paramètre.
EXTRACTION_SANS_RAISONNEMENT=1
# Chemin de ffmpeg, pour convertir les formats que la transcription refuse (amr, 3gp) et les gros fichiers.
FFMPEG=ffmpeg

# Utilisateur de structure : migrations seulement, jamais utilisé par l'application.
DB_STRUCTURE_UTILISATEUR=offregen_structure
DB_STRUCTURE_MOT_DE_PASSE=
